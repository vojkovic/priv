{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "commitMessagePrefix": "[mod]",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "CURL_IMPERSONATE_VERSION = (?<currentValue>v\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "lexiforest/curl-impersonate"
    }
  ],
  "automerge": true,
  "automergeType": "branch",
  "ignoreTests": true
}
